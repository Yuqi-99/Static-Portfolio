{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "src/*": ["./src/*"],
      "/*": ["./public/*"]
    }
  },
  "include": [
    "src",
    ".eslintrc.cjs",
    "tailwind.config.js",
    "stylelint.config.cjs",
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": ["dist"]
}

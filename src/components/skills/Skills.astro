---
import Marquees from 'src/components/skills/Marquees.astro';
import { PROGRAMMING_LANGUAGES, DEVELOPMENT_TOOLS } from 'src/constants/skills';
---

<section class='flex h-full justify-center bg-grey-darkDefault' id='skills'>
	<div class='w-full max-w-[1440px] px-8 py-28'>
		<div class='w-fit rounded-full bg-grey-dark200 px-5 py-2'>
			<p class='text-3xl'>Skills</p>
		</div>

		<div class='mt-12 flex flex-col items-center justify-center'>
			<Marquees data={PROGRAMMING_LANGUAGES} />
			<div class='my-8 max-w-[579px] space-y-4 lg:mb-14 lg:mt-15 lg:space-y-8'>
				<p class='text-center text-[2rem] font-black text-grey-dark900 lg:text-5xl'>
					The skills, tools and technologies <span class='text-grey-dark900'
						>I am really good at</span
					>
				</p>
				<p class='text-center text-sm text-grey-dark500 lg:text-base'>
					I'm still learning more knowledge and hope to make further progress
				</p>
			</div>
			<Marquees reverse data={DEVELOPMENT_TOOLS} />
		</div>
	</div>
</section>

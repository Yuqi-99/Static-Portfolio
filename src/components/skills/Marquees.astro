---
import { cn } from 'src/utils/cn';

const { reverse = false, data } = Astro.props;
---

<div
	class='group mx-auto flex w-full max-w-[1536px] gap-10 overflow-hidden rounded-2xl border bg-grey-light50 py-1.5 dark:border-emerald-800 dark:bg-transparent'
>
	<div
		class={cn(
			'flex h-4/5 min-w-full shrink-0 gap-10 group-hover:[animation-play-state:paused]',
			reverse ? 'marquee-animation-reverse' : 'marquee-animation'
		)}
	>
		{
			data && data.length > 0 ? (
				data.map(
					(content: {
						img: string;
						iconOnlyInLight?: boolean;
						lightImg?: string;
						name: string;
					}) => (
						<>
							{content.iconOnlyInLight ? (
								<div class='h-16 w-16 overflow-hidden dark:hidden'>
									<img src={content.img} alt={content.name} class='h-16 w-auto max-w-none' />
								</div>
							) : (
								<img
									src={content.lightImg ?? content.img}
									alt={content.name}
									class={cn('h-16 w-16 object-contain', content.lightImg && 'dark:hidden')}
								/>
							)}
							{(content.lightImg || content.iconOnlyInLight) && (
								<img
									src={content.img}
									alt={content.name}
									class='hidden h-16 w-16 object-contain dark:block'
								/>
							)}
						</>
					)
				)
			) : (
				<p>Data is empty or not loaded.</p>
			)
		}
	</div>
	<div
		class={cn(
			'flex min-w-full shrink-0 gap-10 group-hover:[animation-play-state:paused]',
			reverse ? 'marquee-animation-reverse' : 'marquee-animation'
		)}
	>
		{
			data && data.length > 0 ? (
				data.map(
					(content: {
						img: string;
						iconOnlyInLight?: boolean;
						lightImg?: string;
						name: string;
					}) => (
						<>
							{content.iconOnlyInLight ? (
								<div class='h-16 w-16 overflow-hidden dark:hidden'>
									<img src={content.img} alt={content.name} class='h-16 w-auto max-w-none' />
								</div>
							) : (
								<img
									src={content.lightImg ?? content.img}
									alt={content.name}
									class={cn('h-16 w-16 object-contain', content.lightImg && 'dark:hidden')}
								/>
							)}
							{(content.lightImg || content.iconOnlyInLight) && (
								<img
									src={content.img}
									alt={content.name}
									class='hidden h-16 w-16 object-contain dark:block'
								/>
							)}
						</>
					)
				)
			) : (
				<p>Data is empty or not loaded.</p>
			)
		}
	</div>
</div>

---
import MenuIcon from '../assets/menu-icon.svg';
import CloseIcon from '../assets/close-icon.svg';

const textStyle = 'text-grey-dark600 hover:text-grey-dark950';
---

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const menuButton = document.getElementById('menu-button');
		const drawer = document.getElementById('drawer-navigation');
		const overlay = document.getElementById('drawer-overlay');
		const closeButton = document.getElementById('drawer-close');
		const navLinks = document.querySelectorAll('#drawer-navigation a');

		function openDrawer() {
			drawer?.classList.remove('translate-x-full');
			overlay?.classList.remove('hidden');
		}

		function closeDrawer() {
			drawer?.classList.add('translate-x-full');
			overlay?.classList.add('hidden');
		}

		menuButton?.addEventListener('click', openDrawer);
		closeButton?.addEventListener('click', closeDrawer);
		overlay?.addEventListener('click', closeDrawer);

		// 监听 Drawer 里的所有导航链接，点击后关闭 Drawer
		navLinks.forEach((link) => {
			link.addEventListener('click', closeDrawer);
		});
	});
</script>

<div class='sticky top-0 z-navigation flex justify-center'>
	<section
		class='flex h-16 w-full max-w-[1440px] items-center justify-end bg-grey-darkDefault/50 font-normal text-grey-dark600 backdrop-blur-lg'
	>
		<div class='flex w-full justify-between px-6'>
			<p class='text-2xl font-bold text-grey-dark800'>{`<YQ />`}</p>
			<div class='hidden items-center gap-10 md:flex'>
				<a href='#/' class={textStyle}>Home</a>
				<a href='#about' class={textStyle}>About</a>
				<a href='#skills' class={textStyle}>Skills</a>
				<a href='#blogs' class={textStyle}>Blogs</a>
			</div>

			<button type='button' id='menu-button' class='flex md:hidden'>
				<MenuIcon class='h-6 w-6' />
			</button>
		</div>
	</section>
</div>

<!-- Drawer Overlay -->
<div id='drawer-overlay' class='fixed inset-0 z-navigation hidden bg-black/50'></div>

<!-- Drawer Navigation -->
<div
	id='drawer-navigation'
	class='fixed right-0 top-0 z-navigation h-full w-64 translate-x-full transform bg-grey-darkDefault shadow-lg transition-transform duration-300 ease-in-out'
>
	<div class='flex items-center justify-between border-b border-grey-dark100 p-4'>
		<p class='text-2xl font-bold text-grey-dark800'>{`<YQ />`}</p>
		<button id='drawer-close'>
			<CloseIcon class='h-4 w-4' />
		</button>
	</div>
	<nav class='flex flex-col gap-4 p-4'>
		<a href='#/' class='text-grey-dark600 hover:text-grey-dark950'>Home</a>
		<a href='#about' class='text-grey-dark600 hover:text-grey-dark950'>About</a>
		<a href='#skills' class='text-grey-dark600 hover:text-grey-dark950'>Skills</a>
		<a href='#blogs' class='text-grey-dark600 hover:text-grey-dark950'>Blogs</a>
	</nav>
</div>
